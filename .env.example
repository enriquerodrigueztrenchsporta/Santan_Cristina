# Google Tag Manager (formato GTM-XXXXXXX). Vacío = no se carga.
PUBLIC_GTM_ID=
# Google Analytics 4 directo, solo si NO se usa GTM (formato G-XXXXXXXXXX).
PUBLIC_GA4_ID=
# Endpoint de formularios (Formspree, Getform, Basin…). Vacío = los formularios abren el correo del usuario.
PUBLIC_FORM_ENDPOINT=
