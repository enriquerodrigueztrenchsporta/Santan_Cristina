---
/**
 * Ilustración botánica decorativa (grabados de dominio público de
 * O. W. Thomé, 1885, entintados en tonos de hayedo otoñal).
 * Se coloca dentro de una sección con `position: relative; overflow: hidden`,
 * normalmente asomando por un borde.
 *
 * Ejemplo: <Botanical plant="haya" style="right:-6%; top:10%" width="34vw" rotate={-12} />
 */
import { getImage } from 'astro:assets';
import haya from '../assets/botanica/haya.png';
import boj from '../assets/botanica/boj.png';
import abeto from '../assets/botanica/abeto.png';
import roble from '../assets/botanica/roble.png';

const PLANTS = { haya, boj, abeto, roble } as const;
export type Plant = keyof typeof PLANTS;

interface Props {
  plant: Plant;
  /** Posición CSS (top/right/bottom/left). */
  style?: string;
  /** Ancho CSS, p. ej. "32vw" o "clamp(220px, 30vw, 520px)". */
  width?: string;
  rotate?: number;
  flip?: boolean;
  opacity?: number;
  /** Sobre fondos oscuros: se ilumina en lugar de multiplicarse con el papel. */
  dark?: boolean;
  /** Deriva suave con el scroll (0 = fija). */
  drift?: number;
  class?: string;
}

const {
  plant,
  style = '',
  width = 'clamp(220px, 30vw, 520px)',
  rotate = 0,
  flip = false,
  opacity,
  dark = false,
  drift = 0.06,
  class: className,
} = Astro.props;

const src = PLANTS[plant];
const widths = [420, 760, 1100].filter((w) => w <= src.width);
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map(async (format) => {
    const imgs = await Promise.all(widths.map((w) => getImage({ src, width: w, format, quality: 70 })));
    return imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
  }),
);
const fallback = await getImage({ src, width: widths[widths.length - 1], format: 'webp', quality: 70 });
const transform = `rotate(${rotate}deg)${flip ? ' scaleX(-1)' : ''}`;
const finalOpacity = opacity ?? (dark ? 0.22 : 0.5);
---

<div
  class:list={['botanical', { 'botanical--dark': dark }, className]}
  style={`${style};--w:${width};--o:${finalOpacity}`}
  aria-hidden="true"
  data-drift={drift || undefined}
>
  <picture>
    <source type="image/avif" srcset={avif} sizes={width} />
    <source type="image/webp" srcset={webp} sizes={width} />
    <img src={fallback.src} alt="" width={src.width} height={src.height} loading="lazy" decoding="async" fetchpriority="low" style={`transform:${transform}`} />
  </picture>
</div>

<style>
  .botanical {
    position: absolute;
    z-index: 0;
    width: var(--w);
    pointer-events: none;
    /* Intensidad de marca de agua: nunca compite con el texto. */
    opacity: calc(var(--o) * 0.62);
    mix-blend-mode: multiply;

  }
  .botanical--dark {
    mix-blend-mode: screen;
    filter: saturate(0.9) brightness(1.15);
  }
  .botanical img {
    width: 100%;
    height: auto;
  }
  @media (max-width: 767.98px) {
    .botanical {
      width: calc(var(--w) * 1.7);
      max-width: 75vw;
      opacity: calc(var(--o) * 0.45);
    }
  }
</style>
