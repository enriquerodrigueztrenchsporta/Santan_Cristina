---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import Botanical from './Botanical.astro';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  lead?: string;
  position?: string;
  crumbs: Crumb[];
  /**
   * tall/medium: foto a sangre con el texto encima.
   * arch: fondo crema con hojas y la foto enmarcada en un arco de medio punto
   * (ideal para fotos de menor resolución que no deben ampliarse a pantalla completa).
   * La página que use `arch` debe pasar `overlayHeader={false}` al layout.
   */
  size?: 'tall' | 'medium' | 'arch';
}

const { lang, image, alt, eyebrow, title, lead, position = 'center', crumbs, size = 'tall' } = Astro.props;
const arch = size === 'arch';
---

{
  arch ? (
    <section class="page-hero page-hero--arch">
      <Botanical plant="haya" style="right:-3%;top:-4%" width="clamp(260px, 34vw, 580px)" rotate={18} opacity={0.4} />
      <div class="container arch-hero">
        <div class="arch-hero__text">
          <Breadcrumbs lang={lang} items={crumbs} />
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="h1 page-hero__title">{title}</h1>
          {lead && <p class="page-hero__lead">{lead}</p>}
          {Astro.slots.has('default') && (
            <div class="page-hero__actions">
              <slot />
            </div>
          )}
        </div>
        <div class="arch-hero__media" data-reveal="fade">
          <Photo src={image} alt={alt} eager arch position={position} ratio="4 / 5" sizes="(min-width: 1024px) 34vw, 86vw" />
        </div>
      </div>
    </section>
  ) : (
    <section class:list={['page-hero', `page-hero--${size}`]}>
      <div class="page-hero__media" data-parallax>
        <Photo src={image} alt={alt} eager position={position} sizes="100vw" />
      </div>
      <div class="page-hero__shade" aria-hidden="true" />
      <div class="container page-hero__content">
        <Breadcrumbs lang={lang} items={crumbs} light />
        <p class="eyebrow eyebrow--light">{eyebrow}</p>
        <h1 class="h1 page-hero__title">{title}</h1>
        {lead && <p class="page-hero__lead">{lead}</p>}
        {Astro.slots.has('default') && (
          <div class="page-hero__actions">
            <slot />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 78svh;
    padding-top: calc(var(--header-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
    color: var(--cream);
    overflow: hidden;
    background: var(--bark-900);
  }
  .page-hero--medium {
    min-height: 62svh;
  }
  .page-hero__media {
    position: absolute;
    inset: -5% 0;
  }
  .page-hero__media :global(.photo) {
    height: 100%;
    border-radius: 0;
  }
  .page-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(26 14 8 / 0.35) 0%, rgb(26 14 8 / 0) 30%),
      linear-gradient(0deg, rgb(26 14 8 / 0.82) 0%, rgb(26 14 8 / 0.35) 55%, rgb(26 14 8 / 0.05) 85%),
      linear-gradient(90deg, rgb(26 14 8 / 0.45) 0%, rgb(26 14 8 / 0) 60%);
  }
  .page-hero__content {
    position: relative;
  }
  .page-hero__title {
    margin-top: var(--space-s);
    max-width: 18ch;
    text-shadow: 0 1px 30px rgb(0 0 0 / 0.25);
  }
  .page-hero__lead {
    margin-top: var(--space-m);
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: rgb(248 240 227 / 0.92);
  }
  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  /* Variante arco */
  .page-hero--arch {
    display: block;
    min-height: 0;
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-2xl);
    background: var(--grain), var(--bg-alt);
    color: var(--copper-500);
  }
  .arch-hero {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    color: var(--text);
  }
  .arch-hero .page-hero__title {
    text-shadow: none;
    max-width: 16ch;
  }
  .arch-hero .page-hero__lead {
    color: var(--text-soft);
  }
  .arch-hero__media {
    width: min(100%, 440px);
    justify-self: center;
  }
  @media (min-width: 1024px) {
    .page-hero--arch {
      min-height: 86svh;
      display: flex;
      align-items: center;
    }
    .arch-hero {
      grid-template-columns: 1.15fr 1fr;
      align-items: end;
    }
    .arch-hero__text {
      padding-bottom: var(--space-l);
    }
    .arch-hero__media {
      justify-self: end;
      width: min(100%, 470px);
    }
  }
</style>
