---
import { hotel } from '../config/site';
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';
import Botanical from './Botanical.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<div class="map" data-map>
  <div class="map__facade">
    <Botanical plant="abeto" dark style="left:-10%;top:-14%" width="58%" rotate={-12} opacity={0.28} drift={0} />
    <Botanical plant="roble" dark style="right:-10%;bottom:-18%" width="52%" rotate={16} opacity={0.2} drift={0} />
    <div class="map__pin" aria-hidden="true">
      <span class="map__dot"></span>
      <span class="map__label">Santa Cristina · N330a km 669</span>
    </div>
    <div class="map__actions">
      <button class="btn btn--light btn--small" type="button" data-map-load data-src={hotel.googleMaps.embed} data-title={t('contact.mapTitle')}>
        {t('contact.mapLoad')}
      </button>
      <a class="map__link" href={hotel.googleMaps.place} target="_blank" rel="noopener">{t('contact.openMaps')}</a>
      <p class="map__note">{t('contact.mapNote')}</p>
    </div>
  </div>
</div>

<style>
  .map {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    background: var(--bark-800);
    color: var(--gold-300);
  }
  @media (min-width: 640px) {
    .map {
      aspect-ratio: 4 / 3;
    }
  }
  .map__facade {
    position: absolute;
    inset: 0;
  }
  .map__pin {
    position: absolute;
    left: 50%;
    top: 42%;
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    transform: translate(-50%, -50%);
    color: var(--cream);
  }
  .map__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--amber-500);
    box-shadow:
      0 0 0 8px rgb(199 119 47 / 0.25),
      0 0 0 18px rgb(199 119 47 / 0.1);
  }
  .map__label {
    font-size: var(--step--2);
    font-weight: 600;
    font-family: var(--ff-display);
    font-style: italic;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .map__actions {
    position: absolute;
    left: var(--space-m);
    right: var(--space-m);
    bottom: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.2rem;
    color: var(--cream);
  }
  .map__link {
    font-size: var(--step--1);
    font-weight: 600;
  }
  .map__note {
    flex-basis: 100%;
    font-size: var(--step--2);
    color: var(--text-on-dark-soft);
  }
  .map :global(.map__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--sand-200);
  }
  .map:global(.is-loaded) .map__facade {
    display: none;
  }
</style>
