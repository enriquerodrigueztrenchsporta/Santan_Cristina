---
import { spa } from '../content/spa';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  detail?: boolean;
}
const { lang, detail = false } = Astro.props;
---

{
  spa.status.closed && (
    <div class="notice" role="note">
      <span class="notice__mark" aria-hidden="true" />
      <div>
        <p class="notice__title">{spa.status.notice[lang]}</p>
        {detail && <p class="notice__detail">{spa.status.detail[lang]}</p>}
      </div>
    </div>
  )
}

<style>
  .notice {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    border: 1px solid currentColor;
    border-left-width: 3px;
    border-radius: var(--radius-m);
    max-width: 44rem;
  }
  .notice__mark {
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--amber-500);
  }
  .notice__title {
    font-weight: 700;
    letter-spacing: 0;
    font-size: var(--step--1);
  }
  .notice__detail {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    opacity: 0.85;
  }
</style>
