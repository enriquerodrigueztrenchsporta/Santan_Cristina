---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Atributo `sizes` según el ancho que ocupa la imagen en pantalla. */
  sizes?: string;
  /** Recorte alternativo para móvil (≤767px), p. ej. una versión vertical del hero. */
  mobileSrc?: ImageMetadata;
  /** Relación de aspecto del contenedor, p. ej. "4 / 5". Omitir para usar la de la foto. */
  ratio?: string;
  /** Posición del recorte (object-position). */
  position?: string;
  eager?: boolean;
  hover?: boolean;
  /** Zoom lento al entrar en pantalla. */
  zoom?: boolean;
  /** Marco en arco de medio punto. */
  arch?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = '100vw',
  mobileSrc,
  ratio,
  position = 'center',
  eager = false,
  hover = false,
  zoom = false,
  arch = false,
  class: className,
} = Astro.props;

const QUALITY = 62;
const MAX = 1920;
const CANDIDATES = [480, 768, 1080, 1440, MAX];
const FORMATS = ['avif', 'webp'] as const;

function widthsFor(img: ImageMetadata) {
  const top = Math.min(img.width, MAX);
  return [...CANDIDATES.filter((w) => w < top), top];
}

async function srcset(img: ImageMetadata, format: 'avif' | 'webp' | 'jpg') {
  const widths = widthsFor(img);
  const out = await Promise.all(widths.map((width) => getImage({ src: img, width, format, quality: QUALITY })));
  return out.map((r, i) => `${r.src} ${widths[i]}w`).join(', ');
}

const mobileSources = mobileSrc
  ? await Promise.all(FORMATS.map(async (format) => ({ format, srcset: await srcset(mobileSrc, format) })))
  : [];
const sources = await Promise.all(FORMATS.map(async (format) => ({ format, srcset: await srcset(src, format) })));
const fallbackWidth = Math.min(src.width, 1080);
const fallback = await getImage({ src, width: fallbackWidth, format: 'jpg', quality: QUALITY });
const fallbackSrcset = await srcset(src, 'jpg');
const style = [ratio ? `aspect-ratio:${ratio}` : '', `--pos:${position}`].filter(Boolean).join(';');
---

<div class:list={['photo', { 'photo--hover': hover, 'photo--arch': arch }, className]} style={style} data-reveal-zoom={zoom ? '' : undefined}>
  <picture>
    {mobileSources.map((s) => <source media="(max-width: 767px)" type={`image/${s.format}`} srcset={s.srcset} sizes="100vw" />)}
    {sources.map((s) => <source type={`image/${s.format}`} srcset={s.srcset} sizes={sizes} />)}
    <img
      src={fallback.src}
      srcset={fallbackSrcset}
      sizes={sizes}
      alt={alt}
      width={fallbackWidth}
      height={Math.round((src.height / src.width) * fallbackWidth)}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </picture>
</div>

<style>
  .photo img {
    object-position: var(--pos, center);
  }
</style>
