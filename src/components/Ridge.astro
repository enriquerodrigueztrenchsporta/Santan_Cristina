---
/**
 * Perfil de cumbres en el borde superior de una sección oscura:
 * dibuja el "cielo" con el color de la sección anterior y deja la
 * montaña del color de la sección. Va dentro de una sección con
 * `position: relative`.
 */
interface Props {
  /** Color de la sección de arriba (CSS). */
  above?: string;
  /** Variante de perfil. */
  variant?: 1 | 2;
}
const { above = 'var(--bg)', variant = 1 } = Astro.props;

const paths = {
  // Siluetas simplificadas: valle, collado y cumbres a distintas alturas.
  1: 'M0 0H1440V38L1382 52 1318 30 1262 44 1204 18 1150 40 1096 34 1040 58 980 46 930 62 872 40 820 50 760 22 712 36 664 30 610 54 556 48 500 66 446 50 392 58 330 34 280 46 226 28 170 44 118 38 60 56 0 42Z',
  2: 'M0 0H1440V52L1390 40 1336 58 1270 26 1224 38 1180 20 1128 42 1072 50 1016 36 958 60 900 44 846 52 790 30 736 42 680 16 630 34 578 40 520 28 466 50 410 44 356 62 300 40 246 52 190 30 140 46 84 36 40 50 0 38Z',
};
---

<svg class="ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`color:${above}`}>
  <path d={paths[variant]} fill="currentColor"></path>
</svg>

<style>
  .ridge {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(26px, 4.5vw, 64px);
    pointer-events: none;
    z-index: 1;
  }
</style>
