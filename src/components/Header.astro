---
import { LANGS, LANG_META, type Lang, type PageKey, pagePath } from '../i18n/config';
import { useT, type UiKey } from '../i18n/ui';
import { buildBookingUrl } from '../lib/booking';
import { booking, hotel } from '../config/site';
import Wordmark from './Wordmark.astro';
import Botanical from './Botanical.astro';

interface Props {
  lang: Lang;
  pageKey: PageKey | '404';
  alternates: Record<Lang, string>;
  overlay: boolean;
}

const { lang, pageKey, alternates, overlay } = Astro.props;
const t = useT(lang);

const nav: { key: PageKey; label: UiKey }[] = [
  { key: 'hotel', label: 'nav.hotel' },
  { key: 'rooms', label: 'nav.rooms' },
  { key: 'elBoj', label: 'nav.elBoj' },
  { key: 'spa', label: 'nav.spa' },
  { key: 'weddings', label: 'nav.weddings' },
  { key: 'pyrenees', label: 'nav.pyrenees' },
  { key: 'contact', label: 'nav.contact' },
];
const mobileExtra: { key: PageKey; label: UiKey }[] = [{ key: 'gallery', label: 'nav.gallery' }];
const bookingUrl = buildBookingUrl({ lang });
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="site-header__inner">
    <a class="site-header__logo" href={pagePath('home', lang)} aria-label={`Santa Cristina Hotel & Petit Spa — ${t('nav.home')}`}>
      <Wordmark />
    </a>

    <nav class="site-nav" aria-label={t('nav.main')}>
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={pagePath(item.key, lang)} aria-current={pageKey === item.key ? 'page' : undefined}>
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ul class="lang-switch" role="list" aria-label={t('nav.language')}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={alternates[l]}
                hreflang={LANG_META[l].hreflang}
                lang={LANG_META[l].hreflang}
                aria-current={l === lang ? 'true' : undefined}
                data-lang-link
              >
                <abbr title={LANG_META[l].label}>{LANG_META[l].short}</abbr>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn--book btn--small site-header__book"
        href={bookingUrl}
        target={booking.newTab ? '_blank' : undefined}
        rel="noopener"
        data-booking-open
        data-track="booking_click"
        data-track-location="header"
      >
        {t('book.cta')}
      </a>
      <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
        <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-toggle__label">{t('nav.menu')}</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu on-dark" aria-label={t('nav.main')}>
  <Botanical plant="boj" dark style="right:-14%;bottom:-6%" width="62vw" rotate={-8} drift={0} />
  <div class="mobile-menu__top">
    <Wordmark />
    <button class="mobile-menu__close" type="button" data-menu-close>
      {t('nav.close')}
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>
  <nav aria-label={t('nav.main')}>
    <ul role="list" class="mobile-menu__list">
      <li><a href={pagePath('home', lang)} aria-current={pageKey === 'home' ? 'page' : undefined}>{t('nav.home')}</a></li>
      {
        [...nav, ...mobileExtra].map((item) => (
          <li>
            <a href={pagePath(item.key, lang)} aria-current={pageKey === item.key ? 'page' : undefined}>
              {t(item.label)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a
      class="btn btn--book"
      href={bookingUrl}
      target="_blank"
      rel="noopener"
      data-booking-open
      data-track="booking_click"
      data-track-location="mobile_menu">{t('book.ctaLong')}</a
    >
    <a class="mobile-menu__phone" href={`tel:${hotel.phone.tel}`}>{hotel.phone.display}</a>
    <ul class="lang-switch lang-switch--menu" role="list" aria-label={t('nav.language')}>
      {
        LANGS.map((l) => (
          <li>
            <a href={alternates[l]} hreflang={LANG_META[l].hreflang} lang={LANG_META[l].hreflang} aria-current={l === lang ? 'true' : undefined}>
              {LANG_META[l].label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--ink);
    background: rgb(248 240 227 / 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition:
      background-color var(--dur-m) var(--ease-out),
      color var(--dur-m) var(--ease-out),
      border-color var(--dur-m) var(--ease-out);
  }
  .site-header--overlay:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: var(--cream);
    border-color: transparent;
  }
  .site-header--overlay:not(.is-scrolled)::before {
    content: '';
    position: absolute;
    inset: 0 0 -70%;
    z-index: -1;
    background: linear-gradient(rgb(26 14 8 / 0.72), rgb(26 14 8 / 0.35) 55%, transparent);
    pointer-events: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: var(--header-h);
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    transition: height var(--dur-m) var(--ease-out);
  }
  .is-scrolled .site-header__inner {
    height: 64px;
  }
  .site-header__logo {
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav {
    display: none;
    margin-inline: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(0.9rem, 1.6vw, 2rem);
  }
  .site-nav a,
  .lang-switch a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-size: 0.95rem;
    font-weight: 550;
    letter-spacing: 0;
    text-decoration: none;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    background: var(--amber-500);
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-m) var(--ease-out);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-left: auto;
  }
  .lang-switch {
    display: none;
    gap: 0.15rem;
  }
  .lang-switch a {
    padding-inline: 0.35rem;
    opacity: 0.7;
  }
  .lang-switch a:hover,
  .lang-switch a[aria-current] {
    opacity: 1;
  }
  .lang-switch a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  .lang-switch abbr {
    text-decoration: none;
  }
  .site-header__book {
    display: none;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    font-size: 0.95rem;
    font-weight: 550;
    letter-spacing: 0;
  }
  .menu-toggle__icon {
    display: grid;
    gap: 6px;
    width: 26px;
  }
  .menu-toggle__icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
  }
  .menu-toggle__icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  @media (min-width: 560px) {
    .site-header__book {
      display: inline-flex;
    }
  }
  @media (min-width: 1180px) {
    .site-nav,
    .lang-switch {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
    .site-header__actions {
      margin-left: 0;
    }
  }

  /* Menú móvil */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(var(--space-l), env(safe-area-inset-bottom));
    border: 0;
    overflow-y: auto;
    display: none;
    flex-direction: column;
    background: var(--bark-900);
    color: var(--text-on-dark);
  }
  .mobile-menu[open] {
    display: flex;
  }
  .mobile-menu::backdrop {
    background: var(--bark-950);
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    position: relative;
  }
  .mobile-menu__close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    border: 0;
    background: none;
    font-size: 0.95rem;
    font-weight: 550;
    letter-spacing: 0;
  }
  .mobile-menu__list {
    position: relative;
    margin-block: var(--space-l);
  }
  .mobile-menu__list a {
    display: block;
    padding-block: 0.45rem;
    font-family: var(--ff-display);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-menu__list a[aria-current='page'] {
    font-style: italic;
    color: var(--gold-300);
  }
  .mobile-menu__foot {
    position: relative;
    margin-top: auto;
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }
  .mobile-menu__phone {
    font-size: var(--step-1);
    text-decoration: none;
  }
  .lang-switch--menu {
    display: flex;
    gap: var(--space-s);
  }
  .lang-switch--menu a {
    font-size: 0.85rem;
    padding-inline: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in var(--dur-m) var(--ease-out);
    }
    @keyframes menu-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
