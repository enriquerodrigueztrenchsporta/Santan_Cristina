---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingDialog from '../components/BookingDialog.astro';
import MobileBar, { type MobileBarMode } from '../components/MobileBar.astro';
import Analytics from '../components/Analytics.astro';
import { SITE_URL } from '../config/site';
import { LANGS, LANG_META, DEFAULT_LANG, type Lang, type PageKey } from '../i18n/config';
import { useT } from '../i18n/ui';
import { stripBase, withBase } from '../lib/url';

interface Props {
  lang: Lang;
  pageKey: PageKey | '404';
  title: string;
  description: string;
  /** Ruta de esta página en cada idioma (para hreflang y selector de idioma). */
  alternates: Record<Lang, string>;
  /** Imagen para redes sociales (URL absoluta o ruta). */
  ogImage?: string;
  /** Nodos Schema.org (ya en formato @graph). */
  schema?: object;
  mobileBar?: MobileBarMode;
  noindex?: boolean;
  /** Cabecera sobre imagen (transparente al inicio). */
  overlayHeader?: boolean;
  /** Color de la última sección (para el perfil de montaña del pie). */
  footerAbove?: string;
}

const {
  lang,
  pageKey,
  title,
  description,
  alternates,
  ogImage = '/og/santa-cristina.jpg',
  schema,
  mobileBar = 'stay',
  noindex = false,
  overlayHeader = true,
  footerAbove,
} = Astro.props;

const t = useT(lang);
const canonical = new URL(stripBase(alternates[lang]), SITE_URL).toString();
const ogImageUrl = new URL(stripBase(ogImage), SITE_URL).toString();
/** Copias de previsualización (GitHub Pages): no se indexan. */
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
---

<!doctype html>
<html lang={LANG_META[lang].hreflang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        LANGS.map((l) => (
          <link rel="alternate" hreflang={LANG_META[l].hreflang} href={new URL(stripBase(alternates[l]), SITE_URL).toString()} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(stripBase(alternates[DEFAULT_LANG]), SITE_URL).toString()} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hotel Santa Cristina Petit Spa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {
      LANGS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2a1b12" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <Analytics />
  </head>
  <body data-page={pageKey}>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} pageKey={pageKey} alternates={alternates} overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} above={footerAbove} />
    <MobileBar lang={lang} mode={mobileBar} />
    <BookingDialog lang={lang} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
